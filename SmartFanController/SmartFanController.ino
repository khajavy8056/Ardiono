/*
 * ============================================================================
 *   کنترل هوشمند دما و سرعت فن  —  Arduino Uno
 * ============================================================================
 *   توضیح کوتاه:
 *     این سیستم به‌صورت مداوم دمای محیط را اندازه می‌گیرد و سرعت فن را
 *     با یک الگوریتم پیوسته (نه حالت‌های ثابت) و به‌صورت خودکار کنترل
 *     می‌کند. با افزایش دما سرعت فن تدریجاً بیشتر و با کاهش دما تدریجاً
 *     کمتر می‌شود. کنترل سرعت با PWM انجام می‌شود.
 *
 *   ساختار پروژه (ماژولار):
 *     • config.h        : تمام تنظیمات (تنها فایلی که کاربر باید ویرایش کند)
 *     • sensors.h/.cpp  : خواندن سنسور (DHT11 / DHT22 / LM35)
 *     • filters.h/.cpp  : فیلتر دما (EMA) و محدودکننده نرخ تغییر سرعت فن
 *     • fan.h/.cpp      : کنترل فن دو سیمه / چهار سیمه و خواندن RPM
 *     • display.h/.cpp  : نمایشگر LCD 16x2 یا OLED 128x64 (به‌صورت اختیاری)
 *     • controller.h/.cpp : الگوریتم کنترل، مدیریت خطا و زمان‌بندی
 *
 *   نحوه اجرا:
 *     دون نیاز به دخالت کاربر؛ پس از آپلود برنامه، سیستم خودکار کار می‌کند.
 * ============================================================================
 */

#include "config.h"
#include "sensors.h"
#include "filters.h"
#include "fan.h"
#include "display.h"
#include "controller.h"

void setup()
{
  // مقداردهی اولیه سریال، سنسور، فن، نمایشگر و کنترل‌کننده
  controllerBegin();
}

void loop()
{
  // اجرای منطق کنترل؛ تمام کارها غیرمسدودکننده و بر اساس millis هستند
  controllerTick(millis());
}
